datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client/seller"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  role         Role     @default(BUYER)
  balance      Float    @default(0.0)
  createdAt    DateTime @default(now())
}